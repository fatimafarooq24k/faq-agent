# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Required. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# ---------------------------------------------------------------
# Everything below is optional - these are the defaults from
# config.py. Uncomment only what you actually want to change.
# ---------------------------------------------------------------

# --- Model ---
# GROQ_MODEL=openai/gpt-oss-120b
# TEMPERATURE=0.2
# MAX_TOKENS=1024

# --- Embeddings ---
# Changing this invalidates the index; ingest.py will rebuild automatically.
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Chunking ---
# CHUNK_SIZE=900
# CHUNK_OVERLAP=120

# --- Retrieval ---
# Maximum cosine DISTANCE for a chunk to count as relevant (0 = identical,
# 1 = unrelated). Calibrate with: python scripts/check_threshold.py
# Raise it if real questions are being refused; lower it if unrelated
# questions get answered.
# TOP_K=5
# RETRIEVAL_THRESHOLD=0.70
# RELATIVE_MARGIN=0.20

# --- Optional reranking (slower, more accurate ordering) ---
# ENABLE_RERANKING=false
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_TOP_K=3

# --- Conversation ---
# MAX_HISTORY_MESSAGES=15

# --- Logging ---
# Set to DEBUG to log the retrieved candidates and their distances.
# LOG_LEVEL=INFO
